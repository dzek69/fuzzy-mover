#!/usr/bin/env bash

set -u

readonly APP_NAME="fuzzy-mover"
readonly CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/$APP_NAME/photos-root"
readonly THEME_CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/$APP_NAME/rofi-theme"
readonly EXCLUDE_CONFIG_FILE="${FUZZY_MOVER_EXCLUDE_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/$APP_NAME/exclude-regexes}"
readonly PLUGIN_FILE="${FUZZY_MOVER_PLUGIN_FILE:-${XDG_DATA_HOME:-$HOME/.local/share}/$APP_NAME/fuzzy-mover.so}"

notify() {
    local urgency="$1"
    local title="$2"
    local message="$3"

    if command -v notify-send >/dev/null 2>&1; then
        notify-send --app-name="$APP_NAME" --urgency="$urgency" "$title" "$message"
    else
        printf '%s: %s\n' "$title" "$message" >&2
    fi
}

fail() {
    notify critical "Fuzzy mover" "$1"
    exit 1
}

set_photos_root() {
    (( $# == 1 )) || fail "Select exactly one directory to use as the Photos root."

    local selected_root="$1"
    local selected_root_real
    local config_dir
    local temporary_config

    [[ -d "$selected_root" ]] || fail "The selected Photos root is not a directory: $selected_root"
    [[ "$selected_root" != *$'\n'* && "$selected_root" != *$'\r'* ]] || \
        fail "The Photos root path cannot contain a line break."

    selected_root_real=$(realpath -e -- "$selected_root") || \
        fail "The selected Photos root cannot be read: $selected_root"
    config_dir=${CONFIG_FILE%/*}
    mkdir -p -- "$config_dir" || fail "The configuration directory could not be created."
    temporary_config=$(mktemp "$config_dir/photos-root.XXXXXX") || \
        fail "A temporary configuration file could not be created."

    if ! printf '%s\n' "$selected_root_real" > "$temporary_config" || \
            ! mv -- "$temporary_config" "$CONFIG_FILE"; then
        rm -f -- "$temporary_config"
        fail "The Photos root configuration could not be saved."
    fi

    notify normal "Fuzzy mover" "Photos root set to: $selected_root_real"
}

trim_whitespace() {
    local value="$1"

    value=${value#"${value%%[![:space:]]*}"}
    value=${value%"${value##*[![:space:]]}"}
    printf '%s' "$value"
}

files_have_same_hash() {
    local first_hash
    local second_hash

    [[ -f "$1" && -f "$2" ]] || return 1
    first_hash=$(sha256sum < "$1") || return 1
    second_hash=$(sha256sum < "$2") || return 1
    [[ "${first_hash%% *}" == "${second_hash%% *}" ]]
}

directory_is_excluded() {
    local relative_path="$1"
    local component
    local exclude_regex

    while true; do
        component=${relative_path%%/*}
        for exclude_regex in "${exclude_regexes[@]}"; do
            if [[ "$component" =~ $exclude_regex ]]; then
                return 0
            fi
        done

        [[ "$relative_path" == */* ]] || break
        relative_path=${relative_path#*/}
    done

    return 1
}

operation="move"
case "${1-}" in
    --set-photos-root)
        shift
        set_photos_root "$@"
        exit 0
        ;;
    --new-s-folder)
        operation="new-s-folder"
        shift
        ;;
    --)
        shift
        ;;
esac

photos_root="${FUZZY_MOVER_PHOTOS_ROOT:-$HOME/Photos}"

if [[ -z "${FUZZY_MOVER_PHOTOS_ROOT:-}" && -r "$CONFIG_FILE" ]]; then
    IFS= read -r configured_root < "$CONFIG_FILE"
    case "$configured_root" in
        "~") photos_root="$HOME" ;;
        "~/"*) photos_root="$HOME/${configured_root#\~/}" ;;
        "") ;;
        *) photos_root="$configured_root" ;;
    esac
fi

rofi_theme="${FUZZY_MOVER_ROFI_THEME-Arc-Dark}"
if [[ -z "${FUZZY_MOVER_ROFI_THEME+x}" && -r "$THEME_CONFIG_FILE" ]]; then
    IFS= read -r rofi_theme < "$THEME_CONFIG_FILE" || true
fi

exclude_regexes=()
if [[ -r "$EXCLUDE_CONFIG_FILE" ]]; then
    exclude_line_number=0
    while IFS= read -r exclude_regex || [[ -n "$exclude_regex" ]]; do
        exclude_line_number=$((exclude_line_number + 1))
        exclude_regex=${exclude_regex%$'\r'}
        [[ -z "$exclude_regex" ]] && continue
        [[ "$exclude_regex" =~ ^[[:space:]]*# ]] && continue

        [[ "" =~ $exclude_regex ]] 2>/dev/null
        regex_status=$?
        (( regex_status != 2 )) || \
            fail "Invalid exclusion regex on line $exclude_line_number: $exclude_regex"
        exclude_regexes+=("$exclude_regex")
    done < "$EXCLUDE_CONFIG_FILE"
fi

(( $# > 0 )) || fail "Dolphin did not pass any files."
command -v rofi >/dev/null 2>&1 || fail "rofi was not found."
command -v sha256sum >/dev/null 2>&1 || fail "sha256sum was not found."
if command -v send2trash >/dev/null 2>&1; then
    trash_command=(send2trash)
elif command -v trash >/dev/null 2>&1; then
    trash_command=(trash)
else
    fail "Neither send2trash nor trash was found."
fi
[[ -d "$photos_root" ]] || fail "The destination directory does not exist: $photos_root"
[[ -f "$PLUGIN_FILE" ]] || fail "The rofi plugin was not found. Run the installer again."

photos_root_real=$(realpath -e -- "$photos_root") || \
    fail "The destination directory cannot be read: $photos_root"

picker_dir=$(mktemp -d "${TMPDIR:-/tmp}/fuzzy-mover.XXXXXX") || \
    fail "A temporary directory could not be created."
trap 'rm -rf -- "$picker_dir"' EXIT HUP INT TERM

choices_file="$picker_dir/choices"
result_file="$picker_dir/result"
rofi_arguments=(
    -plugin-path "${PLUGIN_FILE%/*}"
    -modes fuzzy-mover
    -show fuzzy-mover
    -display-fuzzy-mover "Move to Photos"
    -i
    -matching fuzzy
    -no-sort
)
if [[ -n "$rofi_theme" ]]; then
    rofi_arguments+=(-theme "$rofi_theme")
fi

while IFS= read -r relative_directory; do
    if ! directory_is_excluded "$relative_directory"; then
        printf '%s\n' "$relative_directory"
    fi
done < <(
    find "$photos_root_real" -mindepth 1 -type d -printf '%P\n' 2>/dev/null \
        | LC_ALL=C sort -f
) > "$choices_file"
[[ -s "$choices_file" ]] || fail "No destination directories were found."

FUZZY_MOVER_CHOICES_FILE="$choices_file" \
FUZZY_MOVER_RESULT_FILE="$result_file" \
    rofi "${rofi_arguments[@]}" || exit 0

[[ -s "$result_file" ]] || exit 0
IFS= read -r destination < "$result_file"

[[ -n "$destination" ]] || exit 0
directory_is_excluded "$destination" && \
    fail "The selected directory is excluded by configuration: $destination"

target_dir=$(realpath -e -- "$photos_root_real/$destination") || \
    fail "The selected directory no longer exists: $destination"

# Rofi only receives directories found under Photos. This also rejects a
# symlink that would lead outside the destination tree.
case "$target_dir/" in
    "$photos_root_real/"*) ;;
    *) fail "The selected directory is outside Photos." ;;
esac

if [[ "$operation" == "new-s-folder" ]]; then
    name_arguments=(
        -dmenu
        -p "New S-folder name"
        -l 0
    )
    if [[ -n "$rofi_theme" ]]; then
        name_arguments+=(-theme "$rofi_theme")
    fi

    if ! new_folder_name=$(rofi "${name_arguments[@]}" </dev/null); then
        exit 0
    fi
    new_folder_name=$(trim_whitespace "$new_folder_name")

    [[ -n "$new_folder_name" ]] || fail "The new S-folder name cannot be empty."
    [[ "$new_folder_name" != */* ]] || fail "The new S-folder name cannot contain a slash."
    [[ "$new_folder_name" != *$'\n'* && "$new_folder_name" != *$'\r'* ]] || \
        fail "The new S-folder name cannot contain a line break."

    highest_s_number=0
    while IFS= read -r -d '' existing_directory; do
        existing_name=${existing_directory##*/}
        if [[ "$existing_name" =~ ^S([[:digit:]]+)[[:space:]] ]]; then
            existing_number=${BASH_REMATCH[1]}
            while [[ "$existing_number" == 0* && ${#existing_number} -gt 1 ]]; do
                existing_number=${existing_number#0}
            done
            (( ${#existing_number} <= 18 )) || \
                fail "An existing S-folder number is too large: $existing_name"
            existing_number=$((10#$existing_number))
            if (( existing_number > highest_s_number )); then
                highest_s_number=$existing_number
            fi
        fi
    done < <(find "$target_dir" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null)

    next_s_number=$((highest_s_number + 1))
    while true; do
        new_folder_basename="S$next_s_number $new_folder_name"
        new_target_dir="$target_dir/$new_folder_basename"
        if mkdir -- "$new_target_dir" 2>/dev/null; then
            target_dir="$new_target_dir"
            destination="$destination/$new_folder_basename"
            break
        fi

        if [[ -e "$new_target_dir" || -L "$new_target_dir" ]]; then
            next_s_number=$((next_s_number + 1))
            continue
        fi

        fail "The new S-folder could not be created: $new_folder_basename"
    done
fi

moved=0
renamed=0
duplicates_trashed=0
skipped=0

for source in "$@"; do
    if [[ ! -f "$source" && ! -L "$source" ]]; then
        skipped=$((skipped + 1))
        continue
    fi

    filename=${source##*/}
    stem="$filename"
    extension=""
    filename_without_extension=${filename%.*}
    if [[ "$filename" == *.* && -n "$filename_without_extension" ]]; then
        stem="$filename_without_extension"
        extension=".${filename##*.}"
    fi

    number=0
    while true; do
        if (( number == 0 )); then
            target="$target_dir/$filename"
        else
            target="$target_dir/$stem ($number)$extension"
        fi

        # Never overwrite an existing path, including a broken symlink. Check
        # every occupied numbered variant for identical contents before trying
        # the next available name.
        if [[ -e "$target" || -L "$target" ]]; then
            if [[ "$source" == "$target" ]]; then
                skipped=$((skipped + 1))
                break
            fi

            if files_have_same_hash "$source" "$target"; then
                if "${trash_command[@]}" -- "$source"; then
                    duplicates_trashed=$((duplicates_trashed + 1))
                else
                    skipped=$((skipped + 1))
                fi
                break
            fi

            number=$((number + 1))
            continue
        fi

        if mv --no-clobber -- "$source" "$target"; then
            if [[ ! -e "$source" && ! -L "$source" ]]; then
                moved=$((moved + 1))
                if (( number > 0 )); then
                    renamed=$((renamed + 1))
                fi
                break
            fi

            # The destination may have appeared after the check above. Retry
            # it so it is hashed or numbered just like any other collision.
            if [[ -e "$target" || -L "$target" ]]; then
                continue
            fi
        fi

        skipped=$((skipped + 1))
        break
    done
done

summary="Moved: $moved → $destination"
if (( renamed > 0 )); then
    summary+="; renamed: $renamed"
fi
if (( duplicates_trashed > 0 )); then
    summary+="; duplicates trashed: $duplicates_trashed"
fi
if (( skipped > 0 )); then
    summary+="; skipped: $skipped"
fi

notify normal "Photo organizer" "$summary"
