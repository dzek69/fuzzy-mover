[Desktop Entry]
Type=Service
Name=Fuzzy mover
Name[pl]=Fuzzy mover
MimeType=image/*;
Actions=fuzzyMove;fuzzyMoveNewSFolder;
X-KDE-Priority=TopLevel
X-KDE-MinNumberOfUrls=1

[Desktop Action fuzzyMove]
Name=Move to Photos…
Name[pl]=Przenieś do Photos…
Name[de]=Nach „Photos“ verschieben…
Name[es]=Mover a «Photos»…
Name[fr]=Déplacer vers « Photos »…
Name[it]=Sposta in “Photos”…
Name[pt_BR]=Mover para “Photos”…
Name[uk]=Перемістити до «Photos»…
Name[zh_CN]=移动到“Photos”…
Name[ja]=「Photos」に移動…
Icon=folder-move
Exec=@EXECUTABLE@ %F

[Desktop Action fuzzyMoveNewSFolder]
Name=Move to a New S-folder…
Name[pl]=Przenieś do nowego folderu S…
Name[de]=In einen neuen S-Ordner verschieben…
Name[es]=Mover a una carpeta S nueva…
Name[fr]=Déplacer vers un nouveau dossier S…
Name[it]=Sposta in una nuova cartella S…
Name[pt_BR]=Mover para uma nova pasta S…
Name[uk]=Перемістити до нової S-теки…
Name[zh_CN]=移动到新的 S 文件夹…
Name[ja]=新しい S フォルダーに移動…
Icon=folder-new
Exec=@EXECUTABLE@ --new-s-folder %F
