[Desktop Entry]
Type=Service
Name=Fuzzy mover
Name[pl]=Fuzzy mover
MimeType=image/*;
Actions=fuzzyMove;
X-KDE-Priority=TopLevel
X-KDE-MinNumberOfUrls=1

[Desktop Action fuzzyMove]
Name=Move to Photos…
Name[pl]=Przenieś do Photos…
Name[de]=Nach „Photos“ verschieben…
Name[es]=Mover a «Photos»…
Name[fr]=Déplacer vers « Photos »…
Name[it]=Sposta in “Photos”…
Name[pt_BR]=Mover para “Photos”…
Name[uk]=Перемістити до «Photos»…
Name[zh_CN]=移动到“Photos”…
Name[ja]=「Photos」に移動…
Icon=folder-move
Exec=@EXECUTABLE@ %F
